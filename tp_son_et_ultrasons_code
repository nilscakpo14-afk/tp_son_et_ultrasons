# C- Mesures de la vitesse de phases d'ondes ultrasonores

# 1- Utilisation d'une onde progressive

delta_nu = 1.54e3 # incertitude sur la frequence mesurée a l'oscilloscope en Hz
X_1 = 29.7e-2 # première position en phase des ondes en m
X_2 = 38.4e-2 # 10 e position de phase des ondes en m
delta_X_1 = 0.05e-2 # incertitude sur la position de X_1
delta_X_2 = 0.05e-2 # incertitude sur la position de X_2

lambdaa =(X_2-X_1)/10 # longueur d'onde expérimentale en m
x_1, x_2 = sp.symbols("x_1, x_2")
lambd = (x_2-x_1)/10
variables = [x_1, x_2]
values = np.array([X_1, X_2])
uncertainty = np.array([delta_X_1, delta_X_2])
